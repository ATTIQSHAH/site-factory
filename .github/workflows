name: check-live-links
on: workflow_dispatch
permissions: {contents: write}
concurrency: {group: factory}
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: {python-version: "3.12"}
      - run: pip install -r requirements.txt && python check_live.py
      - run: |
          git config user.name "site-factory"; git config user.email "bot@users.noreply.github.com"
          git add -A; git diff --cached --quiet || (git commit -m "live status" && git push)
